      <CodeComponent name="feedbackCode" plugin="None">
        <Param val="" valType="extendedCode" updates="constant" name="Before Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Before JS Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin Experiment"/>
        <Param val="" valType="extendedCode" updates="constant" name="Begin JS Experiment"/>
        <Param val="let statusLabel;&amp;#10;&amp;#10;if (currentProbeStatus === &quot;old&quot;) {&amp;#10;    statusLabel = &quot;SEEN&quot;;&amp;#10;} else {&amp;#10;    statusLabel = &quot;NOT SEEN&quot;;&amp;#10;}&amp;#10;&amp;#10;let noResponse = (&amp;#10;    probeResp.keys === undefined ||&amp;#10;    probeResp.keys === null ||&amp;#10;    probeResp.keys.length === 0&amp;#10;);&amp;#10;&amp;#10;if (noResponse) {&amp;#10;    feedbackMessage =&amp;#10;        &quot;No response\n\nCorrect answer: &quot; +&amp;#10;        currentCorrectKey.toUpperCase() +&amp;#10;        &quot; (&quot; + statusLabel + &quot;)&quot;;&amp;#10;    feedbackColor = &quot;yellow&quot;;&amp;#10;&amp;#10;} else if (probeResp.corr === 1) {&amp;#10;    feedbackMessage = &quot;Correct&quot;;&amp;#10;    feedbackColor = &quot;green&quot;;&amp;#10;&amp;#10;} else {&amp;#10;    feedbackMessage =&amp;#10;        &quot;Incorrect\n\nCorrect answer: &quot; +&amp;#10;        currentCorrectKey.toUpperCase() +&amp;#10;        &quot; (&quot; + statusLabel + &quot;)&quot;;&amp;#10;    feedbackColor = &quot;red&quot;;&amp;#10;}" valType="extendedCode" updates="constant" name="Begin JS Routine"/>
        <Param val="if currentProbeStatus == &quot;old&quot;:&amp;#10;    statusLabel = &quot;SEEN&quot;&amp;#10;else:&amp;#10;    statusLabel = &quot;NOT SEEN&quot;&amp;#10;&amp;#10;if probeResp.keys in [None, [], '']:&amp;#10;    feedbackMessage = (&amp;#10;        &quot;No response\n\nCorrect answer: &quot;&amp;#10;        + currentCorrectKey.upper()&amp;#10;        + &quot; (&quot;&amp;#10;        + statusLabel&amp;#10;        + &quot;)&quot;&amp;#10;    )&amp;#10;    feedbackColor = &quot;yellow&quot;&amp;#10;&amp;#10;elif probeResp.corr == 1:&amp;#10;    feedbackMessage = &quot;Correct&quot;&amp;#10;    feedbackColor = &quot;green&quot;&amp;#10;&amp;#10;else:&amp;#10;    feedbackMessage = (&amp;#10;        &quot;Incorrect\n\nCorrect answer: &quot;&amp;#10;        + currentCorrectKey.upper()&amp;#10;        + &quot; (&quot;&amp;#10;        + statusLabel&amp;#10;        + &quot;)&quot;&amp;#10;    )&amp;#10;    feedbackColor = &quot;red&quot;" valType="extendedCode" updates="constant" name="Begin Routine"/>
        <Param val="Both" valType="str" updates="None" name="Code Type"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each Frame"/>
        <Param val="" valType="extendedCode" updates="constant" name="Each JS Frame"/>
